# Server Configuration
PORT=3001                    # Server port (default: 3001)

# Client Configuration (via Vite)
# VITE_API_URL=http://localhost:3001/api  # API base URL (dev proxy handles this)

# Database
# SQLite database is stored at server/data/inventory.db
# Schema is auto-created on startup

# File Upload
MAX_FILE_SIZE=10485760       # Max upload file size in bytes (default: 10MB)